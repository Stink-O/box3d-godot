; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Box3D Godot Samples"
config/description="Interactive samples for the Box3D physics engine in Godot."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; Sensor landscape: phones/tablets hold either landscape rotation, never
; portrait (the 1920x1080 layout has no portrait mode; on-device portrait
; loads also crashed the browser build). Desktop windows are unaffected;
; the web exports pair this with a CSS rotate prompt in head_include.
window/handheld/orientation=4

[physics]

common/physics_interpolation=true
; Jolt's default caps are far below the Huge Pyramid's 16,290 blocks: bodies
; past max_bodies (10240) are silently never created, which left the top half
; of the pyramid frozen in the air while the bottom half collapsed. Only read
; when the engine selector has switched the run to Jolt; Box3D and Godot
; Physics ignore them.
jolt_physics_3d/limits/max_bodies=32768
jolt_physics_3d/limits/max_body_pairs=131072
jolt_physics_3d/limits/max_contact_constraints=65536
jolt_physics_3d/limits/temporary_memory_buffer_size=64
; The gyro tops spin at 75 rad/s; Jolt's default clamp (~47) would slow them
; on spawn and they would topple instead of precessing.
jolt_physics_3d/limits/max_angular_velocity=150.0

[rendering]

; Forward+ needs WebGPU, which Godot 4.7 does not have, so the browser build
; must be told to use the Compatibility (WebGL2) renderer. Desktop and Android
; keep whatever the project default is.
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
; Mobile overrides (the ".mobile" feature tag only applies on phones/tablets;
; desktop reads the plain keys above/below and is unaffected). The desktop
; values are heavy for a mobile GPU -- an 8192 shadow map alone is a large
; slice of frame time on a phone -- and were the main source of low FPS on
; device. Same scenes, same cube counts; only shadow resolution and MSAA drop.
anti_aliasing/quality/msaa_3d.mobile=0
; Web overrides. Godot 4.7 has no WebGPU, so the browser build is
; Compatibility/WebGL2 only and never sees Forward+; it also runs the solver on
; one thread. Same scenes, same body counts -- only shadow resolution and MSAA
; drop, exactly as the mobile overrides do. Desktop reads the plain keys.
anti_aliasing/quality/msaa_3d.web=0
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/size.web=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
limits/global_shader_variables/buffer_size=262144
; Required by Godot's Android export gate. The demo ships no textures (all
; meshes are procedural), so this compresses nothing and does not affect the
; desktop demo -- it only satisfies the export check. See ANDROID_BUILD.md.
textures/vram_compression/import_etc2_astc=true
