# SCons / compiler build artifacts
*.os
*.obj
*.o
*.a
*.lib
*.exp
*.pdb
*.ilk
*.gen.cpp
*.gen.h
.sconsign.dblite
compile_commands.json
build_log.txt
msvc_capture.log

# godot-cpp build output (source is a submodule)
godot-cpp/gen/
godot-cpp/bin/

# Godot editor cache
demo/.godot/

# Built libraries land in demo/addons/box3d/bin (since 0.4.3; it was demo/bin
# before). The libraries themselves are ignored by the root .gitignore; this
# also ignores the MSVC intermediates there. A leftover demo/bin folder from an
# older checkout is unused and safe to delete.
demo/addons/box3d/bin/*.exp
demo/addons/box3d/bin/*.lib
demo/addons/box3d/bin/*.pdb
